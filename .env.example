# Supabase PostgreSQL. Use the Transaction Pooler (port 6543) for pooled app traffic.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase project / Auth
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Redis (Apalis queue backend in a later phase)
REDIS_URL=redis://localhost:6379

# LLM providers (configure only the providers you intend to use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase Storage S3-compatible endpoint and credentials
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET=atlas-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

RUST_LOG=info,atlas_api=debug,atlas_worker=debug
API_HOST=0.0.0.0
API_PORT=8080
