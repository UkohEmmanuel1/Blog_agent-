# Supabase PostgreSQL Transaction Pooler (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase project and Auth JWT verification (JWKS is fetched at API startup)
SUPABASE_URL=https://PROJECT_REF.supabase.co
# Optional override; defaults to SUPABASE_URL/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
# Optional: legacy Supabase HS256 JWT secret. Prefer asymmetric JWKS signing keys.
SUPABASE_JWT_SECRET=

# Redis / Apalis
REDIS_URL=redis://localhost:6379

# LLM providers (used by later agent-runtime phase)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Supabase Storage S3-compatible endpoint and credentials (later phase)
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=us-east-1
S3_BUCKET=atlas-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

RUST_LOG=info,atlas_api=debug,atlas_worker=debug
API_HOST=0.0.0.0
API_PORT=8080
